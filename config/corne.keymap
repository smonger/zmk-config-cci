/* Korn split — Whisper Flow / macOS navigation layout (iteration 2) */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    behaviors {
        page_down_80: macro_page_down_80 {
            compatible = "zmk,behavior-macro";
            label = "PAGE_DOWN_80";
            #binding-cells = <0>;

            bindings = <
                &kp DOWN  &kp DOWN  &kp DOWN  &kp DOWN  &kp DOWN
                &kp DOWN  &kp DOWN  &kp DOWN  &kp DOWN  &kp DOWN
                &kp DOWN  &kp DOWN  &kp DOWN  &kp DOWN
            >;
        };

        /* Tap for CMD+TAB; hold for CMD. */
        app_switch: app_switch {
            compatible = "zmk,behavior-hold-tap";
            label = "APP_SWITCH";
            #binding-cells = <2>;
            tapping-term-ms = <220>;
            flavor = "balanced";

            bindings = <&kp>, <&kp>;
        };

        /* A single tap sends two Globe taps for Wispr Flow. */
        wispr_double_tap: macro_wispr_double_tap {
            compatible = "zmk,behavior-macro";
            label = "WISPR_DOUBLE_TAP";
            #binding-cells = <0>;

            bindings = <
                &kp GLOBE
                &kp GLOBE
            >;
        };

        /* Tap for Wispr Flow double-tap activation; hold for push-to-talk. */
        wispr_flow: wispr_flow {
            compatible = "zmk,behavior-hold-tap";
            label = "WISPR_FLOW";
            #binding-cells = <2>;
            tapping-term-ms = <220>;
            flavor = "balanced";

            bindings = <&wispr_double_tap>, <&kp>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        navigation_layer {
            bindings = <
                /* Left half: scrolling and document/application controls */

                &kp PAGE_UP
                &kp PAGE_DOWN
                &kp LG(PAGE_UP)
                &kp LG(PAGE_DOWN)
                &kp LG(LA(PAGE_UP))
                &kp LG(LA(PAGE_DOWN))

                &app_switch LG(TAB) LGUI
                &kp LG(TILDE)
                &kp LG(W)
                &kp LG(T)
                &kp LG(LS(T))
                &kp LG(L)

                &kp UP
                &kp DOWN
                &kp LG(HOME)
                &kp LG(END)
                &kp HOME
                &kp END

                /* Right half: terminal, browser, tabs, and editing */

                &kp LG(SPACE)
                &kp LG(N)
                &kp LC(C)
                &kp LC(R)
                &kp LC(LS(TAB))
                &kp LC(TAB)

                &kp LC(TAB)
                &kp LC(LS(TAB))
                &kp LG(LEFT_BRACKET)
                &kp LG(RIGHT_BRACKET)
                &kp LG(R)
                &kp LG(F)

                &kp LA(LEFT)
                &kp LA(RIGHT)
                &kp LS(LA(LEFT))
                &kp LS(LA(RIGHT))
                &kp BACKSPACE
                &kp F18

                /* Thumbs */

                &wispr_flow &wispr_double_tap LGUI
                &kp SPACE
                &kp RET

                &kp ESC
                &page_down_80
                &none
            >;
        };
    };
};
