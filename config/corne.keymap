/* Korn split — Whisper Flow / macOS navigation layout (proposed seats)
 *
 * Matrix: 12-wide interleaved rows (left 6 outer→inner, right 6 inner→outer),
 * then thumbs (L outer→inner, R inner→outer). See project keymap-physical-map.
 *
 * Layout: layout-brief §3 + 2026-10-01 seat remaps — switcher on bottom
 * (L/R + LGUI + LG(TAB)); 14× scroll macros stay L1.5/L2.5; Page Up/Down on
 * right thumbs; plain Up/Down on former Page seats; Esc/Spotlight/F18 on
 * former Up/Down/next-window seats; next_window on RT2; CMD N ↔ CMD T;
 * Space ↔ CMD Shift T.
 * LT0 F16 = sole Wispr Flow toggle (map Toggle in Wispr app; no GLOBE; no Hammerspoon).
 * L2.0 = &none (freed edge; was duplicate F16).
 * R2.5 F19 = Voice Control listen (Hammerspoon).
 *
 * One-shot app chords (next/close/new window, new tab) use tap macros so a held
 * physical key cannot keep the chord down and trigger macOS key-repeat.
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    behaviors {
        page_down_80: macro_page_down_80 {
            compatible = "zmk,behavior-macro";
            label = "PAGE_DOWN_80";
            #binding-cells = <0>;
            bindings = <
                &kp DOWN &kp DOWN &kp DOWN &kp DOWN &kp DOWN
                &kp DOWN &kp DOWN &kp DOWN &kp DOWN &kp DOWN
                &kp DOWN &kp DOWN &kp DOWN &kp DOWN
            >;
        };

        page_up_80: macro_page_up_80 {
            compatible = "zmk,behavior-macro";
            label = "PAGE_UP_80";
            #binding-cells = <0>;
            bindings = <
                &kp UP &kp UP &kp UP &kp UP &kp UP
                &kp UP &kp UP &kp UP &kp UP &kp UP
                &kp UP &kp UP &kp UP &kp UP
            >;
        };

        /* Tap once on press; do not hold the chord while the key stays down. */
        next_window: macro_next_window {
            compatible = "zmk,behavior-macro";
            label = "NEXT_WINDOW";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <30>;
            bindings = <&kp LG(TILDE)>;
        };

        close_window: macro_close_window {
            compatible = "zmk,behavior-macro";
            label = "CLOSE_WINDOW";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <30>;
            bindings = <&kp LG(W)>;
        };

        new_window: macro_new_window {
            compatible = "zmk,behavior-macro";
            label = "NEW_WINDOW";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <30>;
            bindings = <&kp LG(N)>;
        };

        new_tab: macro_new_tab {
            compatible = "zmk,behavior-macro";
            label = "NEW_TAB";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <30>;
            bindings = <&kp LG(T)>;
        };
    };

    keymap {
        compatible = "zmk,keymap";
        navigation_layer {
            bindings = <
                /* Top: L0.0–L0.5 | R0.0–R0.5
                 * L: LC(R) LG(L) LG([) LG(]) LG(R) LG(F)
                 * R: LA(LEFT) LA(RIGHT) LS(LA(LEFT)) LS(LA(RIGHT)) LC(C) LC(LG(C)) */
                &kp LC(R)  &kp LG(L)  &kp LG(LEFT_BRACKET)  &kp LG(RIGHT_BRACKET)  &kp LG(R)  &kp LG(F)
                &kp LA(LEFT)  &kp LA(RIGHT)  &kp LS(LA(LEFT))  &kp LS(LA(RIGHT))  &kp LC(C)  &kp LC(LG(C))

                /* Home: L1.0–L1.5 | R1.0–R1.5
                 * L: SPACE LG(HOME) | tab 2×2 top | UP + 14× Up
                 * R: ESC Spotlight F18 new_tab LG(LS(T)) LC(LG(F)) */
                &kp SPACE  &kp LG(HOME)  &kp LC(LS(TAB))  &kp LC(TAB)  &kp UP  &page_up_80
                &kp ESC  &kp LG(SPACE)  &kp F18  &new_tab  &kp LG(LS(T))  &kp LC(LG(F))

                /* Bottom: L2.0–L2.5 | R2.0–R2.5
                 * L: none (spare) LS(END) | close + new_window | DOWN + 14× Down
                 * R: LEFT RIGHT LGUI LG(TAB) LG(END) F19 (VC listen) */
                &none  &kp LS(END)  &close_window  &new_window  &kp DOWN  &page_down_80
                &kp LEFT  &kp RIGHT  &kp LGUI  &kp LG(TAB)  &kp LG(END)  &kp F19

                /* Thumbs: LT0–LT2 | RT0–RT2
                 * F16 (Wispr toggle) BACKSPACE RET | PAGE_UP PAGE_DOWN next_window */
                &kp F16  &kp BACKSPACE  &kp RET  &kp PAGE_UP  &kp PAGE_DOWN  &next_window
            >;
        };
    };
};
