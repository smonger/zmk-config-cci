#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

/ {
        behaviors {
        td0: tap_dance_0 {
            compatible = "zmk,behavior-tap-dance";
            label = "TAP_DANCE_0";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&kp LGUI>, <&to 1>;
        };

        mmc: mouse_click {
            compatible = "zmk,behavior-mouse-click";
            label = "MOUSE_CLICK";
            #binding-cells = <1>;
        };

        mmv: mouse_move {
            compatible = "zmk,behavior-mouse-move";
            label = "MOUSE_MOVE";
            #binding-cells = <2>;
        };
};
        
        keymap {
                compatible = "zmk,keymap";

                default_layer {
                        bindings = <
   &kp TAB  &kp Q  &kp W  &kp E  &kp R  &kp T     &kp Y  &kp U  &kp I  &kp O  &kp P  &kp RCTRL
   &kp LGUI  &kp A  &kp S  &kp D  &kp F  &kp G     &kp H  &kp J  &kp K  &kp L  &kp RGUI  &kp SQT
   &kp LSHIFT  &kp Z  &kp X  &kp C  &kp V  &kp B     &kp N  &kp M  &kp COMMA  &kp DOT  &kp FSLH  &kp RSHIFT
                          &mo 3 &lt 1 SPACE &lt 2 RET   &lt 2 ESC &lt 1 BSPC &kp RALT
                        >;
                };
                lower_layer {
                        bindings = <
   &trans  &kp EXCL  &kp AT  &kp HASH  &kp DLLR  &kp PRCNT     &kp CARET  &kp AMPS  &kp STAR  &kp LPAR  &kp RPAR  &trans
   &kp LGUI  &kp N1  &kp N2  &kp N3  &kp N4  &kp N5     &kp N6  &kp N7  &kp N8  &kp N9  &kp N0  &kp RGUI 
   &kp LSHIFT  &kp F1  &kp F2  &kp F3  &kp F4  &kp F5     &kp F6  &kp F7  &kp F8  &kp F9  &kp F10  &kp RSHIFT 
                          	  &trans  &trans  &trans     &trans  &trans  &trans 
                        >;
                };

                raise_layer {
                        bindings = <
   &kp C_PREV  &kp C_NEXT &kp C_PLAY_PAUSE  &kp C_VOLUME_UP &kp C_VOLUME_DOWN &kp C_MUTE      &trans &kp LEFT_BRACE  &kp RIGHT_BRACE  &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &trans
   &trans &kp PIPE  &kp KP_MINUS  &kp UNDERSCORE  &kp KP_EQUAL  &kp KP_PLUS     &kp LEFT  &kp DOWN  &kp UP  &kp RIGHT  &kp COLON  &kp SEMICOLON
   &kp HOME  &kp DELETE  &kp K_CONTEXT_MENU  &kp END  &kp INSERT  &kp PRINTSCREEN     &trans  &kp TILDE  &kp GRAVE  &kp CAPS  &bt BT_SEL 0  &bt BT_CLR
                    	        &trans  &trans  &trans     &trans  &trans  &trans
                        >;
                };

mouse_layer {
    bindings = <
        &trans  &trans  &trans  &trans  &trans  &trans      &trans  &mmc 1  &mmc 2  &trans  &trans  &trans
        &trans  &trans  &trans  &trans  &trans  &trans      &mmv (-5)  (0)  &mmv (0) (-5)  &mmv (0) (5)  &mmv (5) (0)  &trans  &trans
        &trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
                          &trans  &trans  &trans     &trans  &trans  &trans
    >;
};
                };
        };
};
