/* Korn split — Whisper Flow / macOS navigation layout (proposed seats)
 *
 * Matrix: 12-wide interleaved rows (left 6 outer→inner, right 6 inner→outer),
 * then thumbs (L outer→inner, R inner→outer). See project keymap-physical-map.
 *
 * Layout: layout-brief §3 — switcher on bottom (L/R + LGUI + LG(TAB));
 * scroll 2×2 left-inner; tab 2×2 left-center; thumbs Wispr/BS/Enter/Esc/Spotlight/F18.
 * R2.5 F19 = Voice Control listen (Hammerspoon). Plain bindings only — no custom hold-taps.
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    behaviors {
        page_down_80: macro_page_down_80 {
            compatible = "zmk,behavior-macro";
            label = "PAGE_DOWN_80";
            #binding-cells = <0>;
            bindings = <
                &kp DOWN &kp DOWN &kp DOWN &kp DOWN &kp DOWN
                &kp DOWN &kp DOWN &kp DOWN &kp DOWN &kp DOWN
                &kp DOWN &kp DOWN &kp DOWN &kp DOWN
            >;
        };

        page_up_80: macro_page_up_80 {
            compatible = "zmk,behavior-macro";
            label = "PAGE_UP_80";
            #binding-cells = <0>;
            bindings = <
                &kp UP &kp UP &kp UP &kp UP &kp UP
                &kp UP &kp UP &kp UP &kp UP &kp UP
                &kp UP &kp UP &kp UP &kp UP
            >;
        };
    };

    keymap {
        compatible = "zmk,keymap";
        navigation_layer {
            bindings = <
                /* Top: L0.0–L0.5 | R0.0–R0.5
                 * L: LC(R) LG(L) LG([) LG(]) LG(R) LG(F)
                 * R: LA(LEFT) LA(RIGHT) LS(LA(LEFT)) LS(LA(RIGHT)) LC(C) LC(LG(C)) */
                &kp LC(R)  &kp LG(L)  &kp LG(LEFT_BRACKET)  &kp LG(RIGHT_BRACKET)  &kp LG(R)  &kp LG(F)
                &kp LA(LEFT)  &kp LA(RIGHT)  &kp LS(LA(LEFT))  &kp LS(LA(RIGHT))  &kp LC(C)  &kp LC(LG(C))

                /* Home: L1.0–L1.5 | R1.0–R1.5
                 * L: LG(LS(T)) LG(HOME) | tab 2×2 top | scroll 2×2 top
                 * R: UP DOWN LG(TILDE) LG(N) SPACE LC(LG(F)) */
                &kp LG(LS(T))  &kp LG(HOME)  &kp LC(LS(TAB))  &kp LC(TAB)  &kp PAGE_UP  &page_up_80
                &kp UP  &kp DOWN  &kp LG(TILDE)  &kp LG(N)  &kp SPACE  &kp LC(LG(F))

                /* Bottom: L2.0–L2.5 | R2.0–R2.5
                 * L: LS(HOME) LS(END) | tab 2×2 bot | scroll 2×2 bot
                 * R: LEFT RIGHT LGUI LG(TAB) LG(END) F19 (VC listen) */
                &kp LS(HOME)  &kp LS(END)  &kp LG(W)  &kp LG(T)  &kp PAGE_DOWN  &page_down_80
                &kp LEFT  &kp RIGHT  &kp LGUI  &kp LG(TAB)  &kp LG(END)  &kp F19

                /* Thumbs: LT0–LT2 | RT0–RT2
                 * GLOBE BACKSPACE RET | ESC LG(SPACE) F18 */
                &kp GLOBE  &kp BACKSPACE  &kp RET  &kp ESC  &kp LG(SPACE)  &kp F18
            >;
        };
    };
};
