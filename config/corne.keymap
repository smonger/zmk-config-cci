/* Korn split — terminal tabs layout v2 (proposed)
 *
 * Matrix: 12-wide interleaved rows (left 6 outer→inner, right 6 inner→outer),
 * then thumbs (L outer→inner, R inner→outer).
 *
 * Single main layer (navigation_layer). No cmd hold layer.
 * LT0 = Option+W Wispr macro; RT2 = hold LGUI / tap F18 (mod-tap).
 * One-shot tap macros for window/tab/arrows/Cmd+Tab (no macOS key-repeat).
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    behaviors {
        wispr_flow: macro_wispr_flow {
            compatible = "zmk,behavior-macro";
            label = "WISPR_FLOW";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <30>;
            bindings = <&kp LA(W)>;
        };

        close_window: macro_close_window {
            compatible = "zmk,behavior-macro";
            label = "CLOSE_WINDOW";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <30>;
            bindings = <&kp LG(W)>;
        };

        new_window: macro_new_window {
            compatible = "zmk,behavior-macro";
            label = "NEW_WINDOW";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <30>;
            bindings = <&kp LG(N)>;
        };

        new_tab: macro_new_tab {
            compatible = "zmk,behavior-macro";
            label = "NEW_TAB";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <30>;
            bindings = <&kp LG(T)>;
        };

        cmd_tab: macro_cmd_tab {
            compatible = "zmk,behavior-macro";
            label = "CMD_TAB";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <30>;
            bindings = <&kp LG(TAB)>;
        };

        left_arrow: macro_left_arrow {
            compatible = "zmk,behavior-macro";
            label = "LEFT_ARROW";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <30>;
            bindings = <&kp LEFT>;
        };

        right_arrow: macro_right_arrow {
            compatible = "zmk,behavior-macro";
            label = "RIGHT_ARROW";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <30>;
            bindings = <&kp RIGHT>;
        };
    };

    keymap {
        compatible = "zmk,keymap";
        navigation_layer {
            bindings = <
                /* Top: L0.0–L0.5 | R0.0–R0.5 */
                &none  &none  &new_window  &kp LG(SPACE)  &kp LC(LG(F))  &kp ESC
                &kp LG(N1)  &kp LG(N2)  &kp LG(N3)  &kp LG(N4)  &none  &none

                /* Home: L1.0–L1.5 | R1.0–R1.5 */
                &none  &none  &kp LG(LS(T))  &close_window  &left_arrow  &kp UP
                &kp LG(N5)  &kp LG(N6)  &kp LG(N7)  &kp LG(LS(BSLH))  &none  &none

                /* Bottom: L2.0–L2.5 | R2.0–R2.5 */
                &none  &none  &new_tab  &cmd_tab  &right_arrow  &kp DOWN
                &kp LC(TAB)  &kp LG(N8)  &kp LG(N9)  &kp LC(LS(TAB))  &none  &none

                /* Thumbs: LT0–LT2 | RT0–RT2 */
                &wispr_flow  &kp BACKSPACE  &kp RET  &kp PAGE_UP  &kp PAGE_DOWN  &mt LGUI F18
            >;
        };
    };
};
