/*
 * Korn split — Whisper Flow / macOS navigation layout
 *
 * One layer only. Most typing keys are intentionally removed.
 * GLOBE is intended to be held while speaking to activate Whisper Flow.
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    behaviors {
        page_down_80: macro_page_down_80 {
            compatible = "zmk,behavior-macro";
            label = "PAGE_DOWN_80";
            #binding-cells = <0>;
            bindings = <
                &kp DOWN  &kp DOWN  &kp DOWN  &kp DOWN  &kp DOWN
                &kp DOWN  &kp DOWN  &kp DOWN  &kp DOWN  &kp DOWN
                &kp DOWN  &kp DOWN  &kp DOWN  &kp DOWN
            >;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        navigation_layer {
            bindings = <
                /* Top row: experimental utilities                  */
                &kp PAGE_UP       &kp PAGE_DOWN     &kp LG(PAGE_UP)   &kp LG(PAGE_DOWN) &kp LG(LA(PAGE_UP)) &kp LG(LA(PAGE_DOWN))
                &kp LG(SPACE)     &kp LG(N)         &kp LC(C)         &kp LC(R)         &kp LC(LS(TAB))    &kp LC(TAB)

                /* Home row                                      Right half */
                &kp LG(TAB)       &kp LG(TILDE)     &kp LG(W)        &kp LG(T)        &kp LG(LS(T))    &kp LG(L)
                &kp LC(TAB)       &kp LC(LS(TAB))   &kp LG(LEFT_BRACKET) &kp LG(RIGHT_BRACKET) &kp LG(R) &kp LG(F)

                /* Bottom row: lower-priority navigation experiments */
                &kp LG(LS(LEFT_BRACKET)) &kp LG(LS(RIGHT_BRACKET)) &kp LG(HOME) &kp LG(END) &kp HOME &kp END
                &kp LA(LEFT)       &kp LA(RIGHT)      &kp LS(LA(LEFT)) &kp LS(LA(RIGHT)) &none &none

                /* Left thumbs                                    Right thumbs */
                &kp GLOBE         &kp SPACE        &kp RET          &kp ESC          &page_down_80   &kp LG(LC(LA(K)))
            >;
        };
    };
};
