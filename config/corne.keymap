/* Korn split — Whisper Flow / macOS navigation layout
 *
 * Matrix: 12-wide interleaved rows (left 6 outer→inner, right 6 inner→outer),
 * then thumbs (L outer→inner, R inner→outer). See project keymap-physical-map.
 *
 * Switcher option A: LG(TAB) + LGUI + LEFT/RIGHT on right top (R0.0–R0.3).
 * Plain bindings only — no custom hold-taps.
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    behaviors {
        page_down_80: macro_page_down_80 {
            compatible = "zmk,behavior-macro";
            label = "PAGE_DOWN_80";
            #binding-cells = <0>;
            bindings = <
                &kp DOWN &kp DOWN &kp DOWN &kp DOWN &kp DOWN
                &kp DOWN &kp DOWN &kp DOWN &kp DOWN &kp DOWN
                &kp DOWN &kp DOWN &kp DOWN &kp DOWN
            >;
        };

        page_up_80: macro_page_up_80 {
            compatible = "zmk,behavior-macro";
            label = "PAGE_UP_80";
            #binding-cells = <0>;
            bindings = <
                &kp UP &kp UP &kp UP &kp UP &kp UP
                &kp UP &kp UP &kp UP &kp UP &kp UP
                &kp UP &kp UP &kp UP &kp UP
            >;
        };
    };

    keymap {
        compatible = "zmk,keymap";
        navigation_layer {
            bindings = <
                /* Top row: L0.0–L0.5 | R0.0–R0.5 — scroll + switcher cluster */
                &kp PAGE_UP  &kp PAGE_DOWN  &page_up_80  &kp LG(T)  &kp LG(LS(T))  &kp LG(L)
                &kp LG(TAB)  &kp LGUI       &kp LEFT     &kp RIGHT  &kp LG(TILDE)   &kp LG(W)

                /* Home row: L1.0–L1.5 | R1.0–R1.5 — doc nav + Spotlight/Terminal/tabs */
                &kp UP  &kp DOWN  &kp LG(HOME)  &kp LG(END)  &kp LS(HOME)  &kp LS(END)
                &kp LG(SPACE)  &kp LG(N)  &kp LC(C)  &kp LC(R)  &kp LC(LS(TAB))  &kp LC(TAB)

                /* Bottom row: L2.0–L2.5 | R2.0–R2.5 — browser + word hop + overlay */
                &kp LG(LEFT_BRACKET)  &kp LG(RIGHT_BRACKET)  &kp LG(R)  &kp LG(F)  &none  &none
                &kp LA(LEFT)  &kp LA(RIGHT)  &kp LS(LA(LEFT))  &kp LS(LA(RIGHT))  &kp BACKSPACE  &kp F18

                /* Thumbs: LT0–LT2 | RT0–RT2 */
                &kp GLOBE  &kp SPACE  &kp RET  &kp ESC  &page_down_80  &none
            >;
        };
    };
};
