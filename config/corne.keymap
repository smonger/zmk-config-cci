/* Korn split — terminal tabs layout v2 (proposed)
 *
 * Matrix: 12-wide interleaved rows (left 6 outer→inner, right 6 inner→outer),
 * then thumbs (L outer→inner, R inner→outer).
 *
 * Single main layer (navigation_layer). No cmd hold layer.
 * LT0 = Option+W Wispr macro; RT2 = hold LGUI / tap F18 (mod-tap).
 * One-shot tap macros for window/tab/Cmd chords (no macOS key-repeat).
 * hjkl arrows use press/pause/release macros for OS key repeat.
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    behaviors {
        wispr_flow: macro_wispr_flow {
            compatible = "zmk,behavior-macro";
            label = "WISPR_FLOW";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <30>;
            bindings = <&kp LA(W)>;
        };

        close_window: macro_close_window {
            compatible = "zmk,behavior-macro";
            label = "CLOSE_WINDOW";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <30>;
            bindings = <&kp LG(W)>;
        };

        new_window: macro_new_window {
            compatible = "zmk,behavior-macro";
            label = "NEW_WINDOW";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <30>;
            bindings = <&kp LG(N)>;
        };

        next_window: macro_next_window {
            compatible = "zmk,behavior-macro";
            label = "NEXT_WINDOW";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <30>;
            bindings = <&kp LG(GRAVE)>;
        };

        new_tab: macro_new_tab {
            compatible = "zmk,behavior-macro";
            label = "NEW_TAB";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <30>;
            bindings = <&kp LG(T)>;
        };

        cmd_tab: macro_cmd_tab {
            compatible = "zmk,behavior-macro";
            label = "CMD_TAB";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <30>;
            bindings = <&kp LG(TAB)>;
        };

        clear_input_line: macro_clear_input_line {
            compatible = "zmk,behavior-macro";
            label = "CLEAR_INPUT_LINE";
            #binding-cells = <0>;
            wait-ms = <15>;
            tap-ms = <30>;
            bindings = <&kp LC(A) &kp LC(K)>;
        };

        word_macro: macro_word_custom {
            compatible = "zmk,behavior-macro";
            label = "WORD_MACRO";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <30>;
            bindings = <&kp LC(LA(C))>;
        };

        iterm_tab_left: macro_iterm_tab_left {
            compatible = "zmk,behavior-macro";
            label = "ITERM_TAB_LEFT";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <30>;
            bindings = <&kp LG(LEFT)>;
        };

        iterm_tab_right: macro_iterm_tab_right {
            compatible = "zmk,behavior-macro";
            label = "ITERM_TAB_RIGHT";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <30>;
            bindings = <&kp LG(RIGHT)>;
        };

        paste_plain: macro_paste_plain {
            compatible = "zmk,behavior-macro";
            label = "PASTE_PLAIN";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <30>;
            bindings = <&kp LG(V)>;
        };

        hold_left: macro_hold_left {
            compatible = "zmk,behavior-macro";
            label = "HOLD_LEFT";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings =
                <&macro_press &kp LEFT>
                , <&macro_pause_for_release>
                , <&macro_release &kp LEFT>;
        };

        hold_down: macro_hold_down {
            compatible = "zmk,behavior-macro";
            label = "HOLD_DOWN";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings =
                <&macro_press &kp DOWN>
                , <&macro_pause_for_release>
                , <&macro_release &kp DOWN>;
        };

        hold_up: macro_hold_up {
            compatible = "zmk,behavior-macro";
            label = "HOLD_UP";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings =
                <&macro_press &kp UP>
                , <&macro_pause_for_release>
                , <&macro_release &kp UP>;
        };

        hold_right: macro_hold_right {
            compatible = "zmk,behavior-macro";
            label = "HOLD_RIGHT";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings =
                <&macro_press &kp RIGHT>
                , <&macro_pause_for_release>
                , <&macro_release &kp RIGHT>;
        };
    };

    keymap {
        compatible = "zmk,keymap";
        navigation_layer {
            bindings = <
                /* Top: L0.0–L0.5 | R0.0–R0.5 */
                &none  &none  &new_window  &kp LG(SPACE)  &kp LC(LG(F))  &kp ESC
                &next_window  &kp LG(N2)  &kp LG(N3)  &kp LG(N8)  &none  &none

                /* Home: L1.0–L1.5 | R1.0–R1.5 */
                &none  &none  &kp LG(LS(T))  &close_window  &clear_input_line  &cmd_tab
                &kp LG(LS(LEFT))  &kp LG(LS(RIGHT))  &word_macro  &kp LG(N9)  &none  &none

                /* Bottom: L2.0–L2.5 | R2.0–R2.5 — L2.2–L2.5 = vim hjkl */
                &none  &none  &hold_left  &hold_down  &hold_up  &hold_right
                &iterm_tab_left  &iterm_tab_right  &paste_plain  &new_tab  &none  &none

                /* Thumbs: LT0–LT2 | RT0–RT2 */
                &wispr_flow  &kp BACKSPACE  &kp RET  &kp PAGE_UP  &kp PAGE_DOWN  &mt LGUI F18
            >;
        };
    };
};
