/* Korn split — Whisper Flow / macOS navigation layout (iteration 2)
 *
 * Phase 0 baseline: plain GLOBE / LG(TAB) — no custom hold-taps.
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    behaviors {
        page_down_80: macro_page_down_80 {
            compatible = "zmk,behavior-macro";
            label = "PAGE_DOWN_80";
            #binding-cells = <0>;
            bindings = <
                &kp DOWN &kp DOWN &kp DOWN &kp DOWN &kp DOWN
                &kp DOWN &kp DOWN &kp DOWN &kp DOWN &kp DOWN
                &kp DOWN &kp DOWN &kp DOWN &kp DOWN
            >;
        };
    };

    keymap {
        compatible = "zmk,keymap";
        navigation_layer {
            bindings = <
                /* Left half: scrolling and document/application controls */
                &kp PAGE_UP &kp PAGE_DOWN &kp LG(PAGE_UP) &kp LG(PAGE_DOWN) &kp LG(LA(PAGE_UP)) &kp LG(LA(PAGE_DOWN))
                &kp LG(TAB) &kp LG(TILDE) &kp LG(W) &kp LG(T) &kp LG(LS(T)) &kp LG(L)
                &kp UP &kp DOWN &kp LG(HOME) &kp LG(END) &kp HOME &kp END

                /* Right half: terminal, browser, tabs, and editing */
                &kp LG(SPACE) &kp LG(N) &kp LC(C) &kp LC(R) &kp LC(LS(TAB)) &kp LC(TAB)
                &kp LC(TAB) &kp LC(LS(TAB)) &kp LG(LEFT_BRACKET) &kp LG(RIGHT_BRACKET) &kp LG(R) &kp LG(F)
                &kp LA(LEFT) &kp LA(RIGHT) &kp LS(LA(LEFT)) &kp LS(LA(RIGHT)) &kp BACKSPACE &kp F18

                /* Thumbs: Wispr Flow, Space, Enter / Escape, large scroll, spare */
                &kp GLOBE &kp SPACE &kp RET &kp ESC &page_down_80 &none
            >;
        };
    };
};
